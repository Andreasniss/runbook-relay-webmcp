{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "runbook-relay",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "runbook-relay.andreasnissen.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
